#!/bin/bash
# Generic PBS/Apptainer job template for the PixArt-Sigma DiT generation phase. Fill in
# your own project account and scratch path before submitting:
#   qsub -v HPC_PROJECT=<your-project-id> generate_pixart_dit_gpu.pbs
# with HPC_SCRATCH_ROOT set in your environment or exported before qsub.
#PBS -N synth_pixart_dit
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=06:00:00
#PBS -q auto_free
# #PBS -P <your-project-account>   # uncomment and fill in if your cluster requires a project/account line
#PBS -o synth_pixart_dit.out
#PBS -e synth_pixart_dit.err

# NOTE: #PBS -o/-e paths must already exist before this script's first line runs --
# PBS opens them at job dispatch time, before the script body (including any mkdir -p
# here) executes. Four consecutive scheduler-level failures (job held, "too many
# failed attempts to run", run_count=21, Exit_status=-3, no log ever written, on 4
# different nodes) were traced to exactly this: #PBS -o/-e pointed at logs/generate.out
# under a logs/ directory that didn't exist yet. Fixed by writing directly to a
# guaranteed-to-exist directory instead of a subdirectory only the script would create.
set -euo pipefail
ROOT="${HPC_SCRATCH_ROOT:?Set HPC_SCRATCH_ROOT to your scratch working directory, e.g. /scratch/<you>/SynthImage_dit_generation}"
mkdir -p "$ROOT/hf-cache" "$ROOT/pip-cache" \
         "$ROOT/data/content_matched/pixart_dit" "$ROOT/data/content_matched/pixart_dit_embeds"
cd "$ROOT"

# Compute nodes on this cluster have no general internet access (only the login node
# does) -- this job previously failed 21x at the scheduler/prologue level, on three
# different nodes, before its script's first line ever ran, because it tried to pull
# the container from Docker Hub and pip/HF weights from the compute node. Fixed by
# doing ALL network-dependent staging once from the login node beforehand: the
# container is a local .sif (pytorch_cuda.sif, apptainer pull'd already), the venv is
# pre-built with every package already installed, and every model weight file is
# already in hf-cache (see prefetch_pixart.py). This job now touches network nowhere;
# HF_HUB_OFFLINE=1 makes that a hard failure instead of a silent hang if it ever tries.
apptainer exec --nv --cleanenv --no-home \
  --bind "$ROOT:/work" \
  --bind "$ROOT/hf-cache:/hf-cache" \
  "$ROOT/pytorch_cuda.sif" \
  bash -lc '
    set -euo pipefail
    cd /work
    export HOME=/tmp
    export PYTHONNOUSERSITE=1
    export PYTHONPATH=
    export HF_HOME=/hf-cache
    export TRANSFORMERS_CACHE=/hf-cache
    export HF_HUB_OFFLINE=1
    source /work/venv/bin/activate
    python scripts/generate_pixart_dit.py --out data/content_matched/pixart_dit
  '
