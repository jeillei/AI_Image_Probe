#!/bin/bash
#PBS -N synth_final_val
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=08:00:00
#PBS -q auto_free
#PBS -o synth_final_val.out
#PBS -e synth_final_val.err

set -euo pipefail
ROOT="${HPC_SCRATCH_ROOT:?Set HPC_SCRATCH_ROOT to your scratch working directory}"
cd "$ROOT"

apptainer exec --nv --cleanenv --no-home \
  --bind "$ROOT:/work" \
  --bind "$ROOT/hf-cache:/hf-cache" \
  --bind "$ROOT/torch-cache:/torch-cache" \
  "${HPC_SIF:-$ROOT/pytorch_cuda.sif}" \
  bash -lc '
    set -euo pipefail
    cd /work
    export HOME=/tmp
    export PYTHONNOUSERSITE=1
    export PYTHONPATH=
    export HF_HOME=/hf-cache
    export TRANSFORMERS_CACHE=/hf-cache
    export TORCH_HOME=/torch-cache
    source /work/venv/bin/activate

    echo "=== Track B: scaled AI-edit generation ==="
    python scripts/generate_ai_edit_scaled.py --out data/ai_edit_scaled

    echo "=== Building combined Track A+B manifest ==="
    python scripts/build_final_validation_combined_manifest.py

    echo "=== Pass 1: SD1.5-probe feature extraction ==="
    python scripts/extract_stage_panel.py \
      --manifest data/final_validation/combined_manifest.csv \
      --output results/final_validation/panel_features_pass1.json

    echo "=== Pass 2: LPIPS ==="
    python scripts/compute_lpips_panel.py \
      --pass1 results/final_validation/panel_features_pass1.json \
      --output results/final_validation/panel_features_final.json
  '
